{
  "name": "block-empire",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/play", "/play/", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "block-empire",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}